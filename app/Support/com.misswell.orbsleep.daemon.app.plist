<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.misswell.orbsleep.daemon.app</string>
	<!-- Path is relative to the app bundle. SMAppService reads this plist from
	     Contents/Library/LaunchAgents and runs the embedded daemon as the
	     current user, so no /usr/local/bin copy and no sudo are involved. -->
	<key>BundleProgram</key>
	<string>Contents/Resources/orbsleepd</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
